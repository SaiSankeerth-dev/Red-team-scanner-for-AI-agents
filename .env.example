# Copy to `.env` and fill in. Never commit the real `.env`.

# LLM judge (optional — only used as a tiebreaker on ambiguous cases).
# Without a key, Redline runs fully deterministic.
# Any OpenAI-compatible endpoint works. For Gemini:
#   JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   JUDGE_MODEL=gemini-3.8-flash
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini
JUDGE_BASE_URL=
# Legacy names still honored: OPENAI_API_KEY, OPENAI_BASE_URL.

# Campaign database. Defaults to ./redline.db (sqlite).
DATABASE_URL=sqlite:///./redline.db

# Judge spend controls.
REDLINE_MONTHLY_BUDGET_USD=10
REDLINE_JUDGE_MAX_CALLS_PER_CAMPAIGN=50
REDLINE_SPEND_FILE=~/.redline-spend.jsonl

# API server hardening (optional).
REDLINE_API_TOKEN=
REDLINE_API_HOST=127.0.0.1
REDLINE_API_PORT=8899

# Canary webhook receiver (optional).
CANARY_PUBLIC_URL=
CANARY_ALERT_WEBHOOK=
CANARY_HIT_LOG=~/.redline-canary-hits.jsonl
